# Copy to deploy/.env and fill in. Use NEW production values; never reuse the dev ones.

# Public hostname. The app is served at https://DOMAIN and the API at https://api.DOMAIN.
# Both DNS records must point at the server's public IP.
DOMAIN=autolog.example.com

# Postgres (created on first start by the db container)
POSTGRES_DB=autolog
POSTGRES_USER=autolog
POSTGRES_PASSWORD=change-me

# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me

# Google OAuth. Authorized redirect URI: https://api.<DOMAIN>/login/oauth2/code/google
CLIENT_ID=
CLIENT_SECRET=

# Cloudflare R2. The bucket's CORS must allow GET/PUT from https://<DOMAIN>
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_REGION=auto

# SMTP (set up SPF/DKIM/DMARC for the MAIL_FROM domain)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="AutoLog <noreply@example.com>"

# Required by application.yml (no defaults) even if you don't use the demo
DEMO_LOGIN_EN=demo-en@autolog.app
DEMO_LOGIN_PL=demo-pl@autolog.app
DEMO_LOGIN_UK=demo-uk@autolog.app
